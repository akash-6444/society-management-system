<!DOCTYPE html>
<html>

<head>

    <title>Payment</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet">

</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow">

                <div class="card-body">

                    <h3 class="text-center mb-4">
                        Maintenance Payment
                    </h3>

                    <form action="/pay" method="POST">

                        <div class="mb-3">

                            <label>Flat Number</label>

                            <input type="text"
                                   name="flat_no"
                                   class="form-control"
                                   value="<%= flat_no %>"
                                   readonly>

                        </div>

                        <div class="mb-3">

                            <label>Email</label>

                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   required>

                        </div>

                        <div class="mb-3">

                            <label>Amount</label>

                            <input type="number"
                                   name="amount"
                                   class="form-control"
                                   required>

                        </div>

                        <div class="mb-3">

                            <label>Month</label>

                            <input type="text"
                                   name="month"
                                   class="form-control"
                                   required>

                        </div>

                        <button type="submit"
                                class="btn btn-success w-100">

                            Pay Now

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>
</html>